FROM python:3.13-alpine

WORKDIR /app

# Install dependencies for PostgreSQL
RUN apk add postgresql-dev gcc python3-dev musl-dev

# Install uv for better dependency management
RUN pip3 install uv

# Install rss_music_data_model package
COPY data_model data_model

# Install rss_music_migration_handler dependencies
WORKDIR /app/migration_handler

COPY migration_handler/pyproject.toml pyproject.toml
RUN uv sync --no-install-project

# Install rss_music_migration_handler
COPY migration_handler .
RUN uv sync

# Run local handler when container starts
CMD ["uv", "run", "local_handler.py"]
