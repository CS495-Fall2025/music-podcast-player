# If yes, will include features useful when testing a development build. Turn this off
# for production.
VITE_INCLUDE_DEV_FEATURES=yes

# If yes, will print lightning payments instead of sending them using keysend. Do not
# enable in production.
VITE_BLOCK_LIGHTNING_PAYMENTS=no

# If not blank, will send lightning payments to this address instead of each recipient's
# address. Do not enable in production.
VITE_LIGHTNING_RECIPIENT_OVERRIDE=0255d1afddb7d2606a509f059f8c619d8a8e5b300b25a5d73d12ca1f4b3a2c0ae2
