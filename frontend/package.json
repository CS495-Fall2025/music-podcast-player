{
  "name": "RSS Music Player",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev-docker": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "lint": "eslint",
    "format-check": "prettier --check .",
    "format-fix": "prettier --write ."
  },
  "dependencies": {
    "@getalby/bitcoin-connect": "^3.11.4",
    "vue": "^3.5.22",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.34.0",
    "eslint-plugin-vue": "^10.4.0",
    "globals": "^16.3.0",
    "jsdom": "^27.1.0",
    "prettier": "3.6.2",
    "vite": "^7.1.2",
    "vitest": "^1.4.5"
  },
  "devDependenciesMeta": {
    "vitest": {
      "optional": false
    }
  },
  "vitest": {
    "globals": true,
    "environment": "jsdom",
    "include": [
      "tests/**/*.test.js"
    ],
    "setupFiles": [
      "tests/setup/dom-mock.js",
      "tests/setup/router-mock.js"
    ]
  }
}
